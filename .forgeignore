# Vibe2Prod .forgeignore — Intentional design decisions and known limitations
# See: https://github.com/christopher-igweze/forge-engine docs for rule syntax

# ── Historical / Non-Runtime Files ─────────────────────────────────
- pattern: ".*"
  path: "supabase/migrations/**"
  reason: "Migration SQL is historical DDL — not runtime code. Token storage schema is correct; encryption happens at the application layer."

- pattern: ".*"
  path: "tasks/**"
  reason: "Task/plan documents are development artifacts, not production code."

# ── Intentional Auth Design ────────────────────────────────────────
- pattern: "probe.*authentication|probe.*unauthenticated|unauthenticated.*probe"
  category: security
  reason: "Probe endpoints use UUID-as-capability-token pattern. Anonymous access to probe results by ID is intentional — the UUID is the authorization token."

# ── Known Infrastructure Limitations ──────────────────────────────
- pattern: "rate.limit.*per.process|rate.limit.*worker|rate.limit.*distributed"
  reason: "Per-process rate limiting is a known limitation. Redis-backed distributed rate limiting tracked in backlog."
  expires: "2026-09-01"

- pattern: "webhook.*replay.*cache|webhook.*cache.*unbounded|webhook.*cache.*growth"
  reason: "Webhook delivery cache is bounded at 10K entries with FIFO eviction and periodic cleanup. Memory growth is controlled."

# ── Architecture Opinions ──────────────────────────────────────────
- category: architecture
  max_severity: medium
  reason: "Architecture findings are capped at MEDIUM per team policy. Structural improvements are tracked as tech debt, not blockers."

# ── Config / Debug Observations ────────────────────────────────────
- pattern: "debug.mode.*bypass|debug.*misconfiguration"
  category: security
  reason: "Debug mode is blocked by config validator in non-development environments. The validator raises ValueError at startup."

- pattern: "CORS.*missing.*production|CORS.*misconfiguration"
  reason: "CORS is configured via CORS_ALLOWED_ORIGINS env var in production. Missing config triggers a startup warning. Fallback is localhost-only."

# ── OAuth Edge Cases Already Addressed ─────────────────────────────
- pattern: "OAuth.*state.*CSRF|OAuth.*state.*nonce.*HMAC"
  max_severity: low
  reason: "OAuth state uses JWT with expiry + atomic DB consumption (UNIQUE constraint). CSRF is mitigated by state parameter validation."

- pattern: "encryption.key.*rotation.*not.documented"
  reason: "Key rotation procedure documented in config.py docstring for github_token_encryption_key field."

# ── Verified Fixes (Round 5 — False Positive Suppressions) ───────
- pattern: "GitHub.*OAuth.*token.*storage.*without.*encryption|token.*stored.*plaintext"
  reason: "encrypt_token() called in github_token_manager.connect_user() before storage. decrypt_token() in oauth_repository.get_github_access_token(). Verified rounds 1, 5."

- pattern: "plaintext.*API.*keys.*error.*messages|sensitive.*data.*exception|API.*key.*leaked.*log"
  reason: "_redact_exception_message() with _SENSITIVE_PATTERNS regex applied in _log_exception() in main.py. Verified rounds 4, 5."

- pattern: "webhook.*signature.*not.*applied.*all.*handlers|webhook.*handler.*missing.*signature"
  reason: "webhook.py validates GitHub HMAC-SHA256 signatures; webhook_clerk.py validates Svix signatures via svix.webhooks.Webhook.verify(). Verified round 5."

- pattern: "missing.*user_id.*ownership.*scan|scan.*endpoint.*missing.*authorization|IDOR.*scan"
  reason: "Defense-in-depth ownership checks in user.py: list_scans filters by project.user_id, get_scan_detail double-checks scan.user_id and project.user_id. Verified rounds 3, 4, 5."

- pattern: "silent.*telemetry.*failure|telemetry.*error.*swallowed|telemetry.*bare.*pass"
  reason: "All catch blocks in telemetry.py use logger.exception() for full traceback logging. Verified rounds 4, 5."

- pattern: "missing.*input.*validation.*repository.*URL|repo.*URL.*not.*validated"
  reason: "_GITHUB_URL_RE regex validates GitHub URL format in audit.py before any downstream use. Verified rounds 4, 5."

- pattern: "OAuth.*state.*atomic.*consumption|OAuth.*state.*race.*condition|OAuth.*TOCTOU"
  reason: "consume_oauth_state_atomic() uses INSERT with UNIQUE constraint for atomic check-and-consume. Used in validate_oauth_state(). Verified rounds 3, 5."

- pattern: "OAuth.*redirect.*URI.*not.*validated|redirect.*URI.*validation.*insufficient"
  reason: "validate_redirect_uri() uses urlparse for URL parsing, allowlist comparison with hmac.compare_digest for timing-safe checks. Called in both get_auth_url() and _exchange_code(). Verified rounds 1, 3, 5."

- pattern: "sensitive.*data.*query.*param|query.*string.*sensitive.*data.*logged"
  reason: "_sanitize_url() uses allowlist approach (_SAFE_QUERY_PARAMS) — all non-allowlisted params redacted to '***'. Applied in AccessLogMiddleware and _log_exception(). Verified rounds 3, 5."

- pattern: "frontend.*API.*client.*error.*handling|API.*client.*missing.*error.*middleware"
  reason: "errorMiddleware normalizes HTTP errors into ApiError; retryMiddleware handles network failures with exponential backoff. Both composed into apiFetch pipeline. Verified rounds 3, 5."

- pattern: "unhandled.*promise.*rejection.*API.*client|API.*client.*unhandled.*error"
  reason: "errorMiddleware catches non-ok responses and throws typed ApiError. retryMiddleware catches network TypeError. Composition covers both error classes. Verified round 5."

- pattern: "missing.*pagination.*project.*scans|project.*scans.*unbounded"
  reason: "get_project_scans in user.py accepts limit query param (default 20, max 100) passed to db.get_project_with_scans(). Verified rounds 4, 5."

# ── Test Files — Not Production Code ─────────────────────────────
- pattern: ".*"
  path: "tests/**"
  reason: "Test files contain intentional security test cases — assertions about validation behavior, not production vulnerabilities."

# ── Verified Fixes (Round 6 — Additional False Positive Suppressions) ──
- pattern: "unencrypted.*token|token.*stored.*plaintext|token.*without.*encryption"
  reason: "encrypt_token() called in github_token_manager.connect_user(). decrypt_token() in oauth_repository. Verified across rounds 1-6."

- pattern: "error.*boundary.*root|missing.*error.*boundary"
  reason: "ErrorBoundary component in components/error-boundary.tsx wraps children in layout.tsx. Verified round 6."

- pattern: "debug.*mode.*enabled.*non-production|debug.*mode.*can.*be.*enabled"
  reason: "config.py _validate_production_security raises ValueError if debug=True outside development. Verified rounds 1, 3, 6."

- pattern: "silently.*swallowed.*error.*telemetry|silent.*failure.*telemetry"
  reason: "All telemetry catch blocks use logger.exception() for full traceback. Verified rounds 4, 5, 6."

- pattern: "JWT.*secret.*validation.*insufficient|JWT.*secret.*length"
  reason: "_validate_jwt_secret_encoding checks base64 validity. Length is Supabase-determined — we validate format, not length."

- pattern: "CORS.*lacks.*explicit.*origin.*production|CORS.*configuration.*missing.*production"
  reason: "_validate_cors_production warns in production without explicit origins. Fallback is localhost-only. Verified rounds 3, 6."

- pattern: "encryption.*key.*rotation.*document|encryption.*key.*validation.*present"
  reason: "_validate_encryption_key checks base64 + 32 bytes at startup. Rotation procedure in config.py docstring. Verified rounds 3, 5, 6."

- pattern: "environment.*variables.*hardcoded.*build.*time|API.*URL.*exposed.*bundle"
  category: security
  max_severity: low
  reason: "NEXT_PUBLIC_ env vars are standard Next.js pattern for client-side config. Only public API URLs are exposed, not secrets."

- pattern: "API.*key.*localStorage.*without.*encryption|localStorage.*secure.*flag"
  max_severity: low
  reason: "Browser API keys in localStorage is standard auth pattern (same as JWT tokens). HttpOnly cookies not applicable for SPA API calls."
