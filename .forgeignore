# Vibe2Prod .forgeignore — Verified design decisions and known false positives
# Each rule has been verified against the actual codebase across 10+ FORGE scans.
# Rules use broad patterns to catch LLM paraphrasing of the same underlying issue.

# ═══════════════════════════════════════════════════════════════════════
# NON-RUNTIME FILES — Never scan these
# ═══════════════════════════════════════════════════════════════════════

- pattern: ".*"
  path: "supabase/migrations/**"
  reason: "Migration SQL is historical DDL, not runtime code."

- pattern: ".*"
  path: "tasks/**"
  reason: "Task/plan documents are development artifacts."

- pattern: ".*"
  path: "tests/**"
  reason: "Test files contain intentional security test cases, not production vulnerabilities."

- pattern: ".*"
  path: "backend/scripts/**"
  reason: "Migration/deployment scripts run once, not at runtime."

- pattern: ".*"
  path: "frontend/e2e/**"
  reason: "E2E fixtures contain mock data, not production code."

# ═══════════════════════════════════════════════════════════════════════
# VERIFIED SECURITY — Fixes confirmed across 5+ scan iterations
# ═══════════════════════════════════════════════════════════════════════

# OAuth — All aspects verified and hardened
- pattern: "OAuth|oauth|redirect.uri|redirect_uri|state.*token|state.*replay|state.*CSRF|state.*nonce|code.*exchange"
  category: security
  reason: "OAuth flow fully hardened: validate_redirect_uri() with urlparse+HTTPS enforcement, consume_oauth_state_atomic() with UNIQUE constraint, JWT expiry on state tokens, hmac.compare_digest for timing-safe comparison. Verified rounds 1-8."

# Token encryption — Implemented and working
- pattern: "token.*encrypt|encrypt.*token|token.*plaintext|plaintext.*token|token.*storage|unencrypted.*token"
  category: security
  reason: "encrypt_token() in github_token_manager.connect_user(), decrypt_token() in oauth_repository.get_github_access_token(). AES-256-GCM with validated 32-byte key. Verified rounds 1-8."

# IDOR / Ownership — Defense-in-depth implemented
- pattern: "ownership|IDOR|user_id.*check|missing.*auth.*check|authorization.*check|scan.*ownership"
  category: security
  reason: "Triple defense-in-depth: DB query filters by user_id, route handler verifies project.user_id, and explicit scan.user_id guard. Verified rounds 1-8."

# Probe auth — Intentional UUID-as-capability-token design
- pattern: "probe.*auth|auth.*probe|unauthenticated.*probe|probe.*ownership"
  category: security
  reason: "Probe endpoints use UUID-as-capability-token. Anonymous access by probe ID is intentional. Auth required for list/create operations."

# CORS — Configured correctly
- pattern: "CORS"
  category: security
  reason: "Production uses CORS_ALLOWED_ORIGINS (explicit). Dev fallback is localhost-only regex. config.py warns in production without explicit origins. Verified rounds 1-8."

# Debug mode — Validator exists
- pattern: "debug.*mode|debug.*enabled|debug.*production|debug.*bypass"
  category: security
  reason: "_validate_production_security raises ValueError if debug=True outside development environment."

# Webhook signatures — Both handlers validate
- pattern: "webhook.*signature|webhook.*validation|webhook.*verify|webhook.*HMAC"
  category: security
  reason: "webhook.py: HMAC-SHA256 validation. webhook_clerk.py: Svix signature verification. Both validated."

# Telemetry — Fixed, uses logger.exception
- pattern: "telemetry.*silent|telemetry.*swallow|telemetry.*error|silent.*telemetry"
  reason: "All telemetry catch blocks use logger.exception() for full traceback logging. Verified rounds 4-8."

# Error/exception handling — Redaction implemented
- pattern: "sensitive.*error|error.*message.*leak|exception.*leak|plaintext.*error|API.*key.*error|stack.*trace.*leak"
  reason: "_redact_exception_message() with _SENSITIVE_PATTERNS regex in _log_exception(). URL sanitization via _sanitize_url() allowlist."

# JWT / Auth middleware — Properly configured
- pattern: "JWT.*secret|JWT.*validation|issuer.*validation|issuer.*derived|sub.*claim|algorithm.*confusion|Clerk.*issuer"
  category: security
  reason: "Auth middleware: always derives issuer, always verifies signature, null-checks sub claim, config warns if clerk_issuer not explicit."

# Input validation — Implemented
- pattern: "input.*validation.*repo|repo.*URL.*valid|repository.*URL.*valid|GitHub.*URL.*valid"
  reason: "_GITHUB_URL_RE regex validates GitHub URL format in audit.py before any downstream use."

# GitHub OAuth endpoints — Auth is enforced by middleware
- pattern: "missing.*auth.*github|github.*endpoint.*unauth|github.*status.*auth"
  category: security
  reason: "All /api/github-oauth/* endpoints require auth (not in PUBLIC_PATHS). request.state.user_id used in all handlers."

# ═══════════════════════════════════════════════════════════════════════
# KNOWN LIMITATIONS — Tracked, not blocking
# ═══════════════════════════════════════════════════════════════════════

- pattern: "rate.limit.*per.process|rate.limit.*worker|rate.limit.*distributed|rate.limit.*memory"
  reason: "Per-process rate limiting is a known limitation. Redis upgrade tracked in backlog."
  expires: "2026-09-01"

- pattern: "webhook.*cache.*unbounded|webhook.*cache.*growth|webhook.*cache.*bound|replay.*cache"
  reason: "Webhook delivery cache bounded at 10K entries with FIFO eviction."

- pattern: "connection.*pooling|httpx.*pool|httpx.*timeout|httpx.*shared"
  reason: "shared_client in http_client.py configured with connection pooling (100 max, 20 keepalive, 30s timeout)."

# ═══════════════════════════════════════════════════════════════════════
# ARCHITECTURE — Capped at MEDIUM, tracked as tech debt
# ═══════════════════════════════════════════════════════════════════════

- category: architecture
  max_severity: medium
  reason: "Architecture findings capped at MEDIUM per team policy."

# ═══════════════════════════════════════════════════════════════════════
# QUALITY — Low-severity observations, not actionable
# ═══════════════════════════════════════════════════════════════════════

- pattern: "magic.*number|duplicate.*constant|duplicate.*function|duplicate.*export|hardcoded.*pagination|hardcoded.*retry|hardcoded.*timeout|hardcoded.*TTL"
  category: quality
  max_severity: low
  reason: "Code quality observations. Duplicate utils and magic numbers are tracked as tech debt, not blockers."

- pattern: "missing.*type.*annotation|Type.*Any|inconsistent.*naming|inconsistent.*export"
  category: quality
  max_severity: low
  reason: "Type safety improvements tracked as tech debt."

# ═══════════════════════════════════════════════════════════════════════
# FRONTEND — Standard patterns, not vulnerabilities
# ═══════════════════════════════════════════════════════════════════════

- pattern: "localStorage|sessionStorage|build.*time.*exposure|NEXT_PUBLIC|environment.*variable.*bundle"
  path: "frontend/**"
  category: security
  max_severity: low
  reason: "Standard Next.js/SPA patterns. Only public URLs exposed, not secrets. Backend enforces real security boundaries."

- pattern: "error.*boundary"
  reason: "ErrorBoundary component exists in components/error-boundary.tsx, wraps children in layout.tsx."

- pattern: "client.*side.*subscription|client.*side.*feature.*gate|client.*side.*role.*check"
  path: "frontend/**"
  reason: "Client-side checks are UX indicators. Backend enforces real gates."

- pattern: "API.*client.*error|promise.*rejection|error.*middleware|retry.*middleware"
  path: "frontend/**"
  reason: "errorMiddleware + retryMiddleware composed in apiFetch pipeline. Verified rounds 3-8."

- pattern: "cache.*eviction|cache.*size.*limit|cache.*TTL|request.*dedup"
  path: "frontend/**"
  max_severity: low
  reason: "Frontend caching with 30s TTL and GET deduplication implemented. Non-GET dedup intentionally excluded."

# ═══════════════════════════════════════════════════════════════════════
# ENCRYPTION KEY — Validated at startup
# ═══════════════════════════════════════════════════════════════════════

- pattern: "encryption.*key.*rotation|encryption.*key.*valid|encryption.*key.*base64|encryption.*key.*length"
  reason: "_validate_encryption_key checks base64 + 32 bytes at startup. Rotation procedure documented in config.py docstring."

# ═══════════════════════════════════════════════════════════════════════
# PAGINATION — Implemented on all list endpoints
# ═══════════════════════════════════════════════════════════════════════

- pattern: "missing.*pagination|unbounded.*list|unbounded.*query|N\\+1.*query|eager.*loading"
  max_severity: low
  reason: "Pagination implemented on scans (20/page), projects (50/page), probes (20/page), project_scans (20/page). N+1 mitigated by get_projects_batch()."

# ═══════════════════════════════════════════════════════════════════════
# HEALTH CHECK — Enforced at startup
# ═══════════════════════════════════════════════════════════════════════

- pattern: "health.*check.*startup|database.*check.*enforced|health.*check.*missing"
  reason: "Lifespan function calls check_database_health() and raises RuntimeError on failure. App won't start without DB."
