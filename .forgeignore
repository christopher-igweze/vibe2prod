# Vibe2Prod .forgeignore v2 — Verified design decisions and known false positives
# Each rule has been verified against the actual codebase across 10+ FORGE scans.
# Migrated from v1 to v2 structured suppression format.

version: 2
suppressions:

  # ═══════════════════════════════════════════════════════════════════════
  # NON-RUNTIME FILES — Never scan these
  # ═══════════════════════════════════════════════════════════════════════

  - id: sup_001
    kind: test_fixture
    match:
      file: "supabase/migrations/**"
    reason: "Migration SQL is historical DDL, not runtime code."

  - id: sup_002
    kind: test_fixture
    match:
      file: "tasks/**"
    reason: "Task/plan documents are development artifacts."

  - id: sup_003
    kind: test_fixture
    match:
      file: "tests/**"
    reason: "Test files contain intentional security test cases, not production vulnerabilities."

  - id: sup_004
    kind: test_fixture
    match:
      file: "backend/scripts/**"
    reason: "Migration/deployment scripts run once, not at runtime."

  - id: sup_005
    kind: test_fixture
    match:
      file: "frontend/e2e/**"
    reason: "E2E fixtures contain mock data, not production code."

  # ═══════════════════════════════════════════════════════════════════════
  # VERIFIED SECURITY — Fixes confirmed across 5+ scan iterations
  # ═══════════════════════════════════════════════════════════════════════

  # OAuth — All aspects verified and hardened
  - id: sup_006
    kind: already_fixed
    match:
      rule_family: open-redirect
      file: "backend/services/repositories/oauth_repository.py"
    reason: "OAuth flow fully hardened: validate_redirect_uri() with urlparse+HTTPS enforcement, consume_oauth_state_atomic() with UNIQUE constraint, JWT expiry on state tokens, hmac.compare_digest for timing-safe comparison. Verified rounds 1-8."

  - id: sup_007
    kind: already_fixed
    match:
      rule_family: open-redirect
      file: "backend/api/routes/github_oauth.py"
    reason: "OAuth flow fully hardened: validate_redirect_uri() with urlparse+HTTPS enforcement, consume_oauth_state_atomic() with UNIQUE constraint, JWT expiry on state tokens, hmac.compare_digest for timing-safe comparison. Verified rounds 1-8."

  # Token encryption — Implemented and working
  - id: sup_008
    kind: already_fixed
    match:
      rule_family: weak-crypto
      file: "backend/services/github_token_manager.py"
    reason: "encrypt_token() in github_token_manager.connect_user(), decrypt_token() in oauth_repository.get_github_access_token(). AES-256-GCM with validated 32-byte key. Verified rounds 1-8."

  # IDOR / Ownership — Defense-in-depth implemented
  - id: sup_009
    kind: already_fixed
    match:
      rule_family: idor
      file: "backend/api/routes/**"
    reason: "Triple defense-in-depth: DB query filters by user_id, route handler verifies project.user_id, and explicit scan.user_id guard. Verified rounds 1-8."

  # Probe auth — Intentional UUID-as-capability-token design
  - id: sup_010
    kind: already_fixed
    match:
      rule_family: missing-auth-check
      file: "backend/api/routes/probe.py"
    reason: "Probe endpoints use UUID-as-capability-token. Anonymous access by probe ID is intentional. Auth required for list/create operations."

  # CORS — Configured correctly
  - id: sup_011
    kind: already_fixed
    match:
      rule_family: cors-misconfiguration
      file: "backend/config.py"
    reason: "Production uses CORS_ALLOWED_ORIGINS (explicit). Dev fallback is localhost-only regex. config.py warns in production without explicit origins. Verified rounds 1-8."

  # Debug mode — Validator exists
  - id: sup_012
    kind: already_fixed
    match:
      rule_family: sensitive-data-exposure
      file: "backend/config.py"
    reason: "_validate_production_security raises ValueError if debug=True outside development environment."

  # Webhook signatures — Both handlers validate
  - id: sup_013
    kind: already_fixed
    match:
      rule_family: missing-input-validation
      file: "backend/api/routes/webhook.py"
    reason: "webhook.py: HMAC-SHA256 validation. webhook_clerk.py: Svix signature verification. Both validated."

  - id: sup_014
    kind: already_fixed
    match:
      rule_family: missing-input-validation
      file: "backend/api/routes/webhook_clerk.py"
    reason: "webhook.py: HMAC-SHA256 validation. webhook_clerk.py: Svix signature verification. Both validated."

  # Telemetry — Fixed, uses logger.exception
  - id: sup_015
    kind: already_fixed
    match:
      rule_family: missing-error-handling
      file: "backend/services/repositories/telemetry_repository.py"
    reason: "All telemetry catch blocks use logger.exception() for full traceback logging. Verified rounds 4-8."

  # Error/exception handling — Redaction implemented
  - id: sup_016
    kind: already_fixed
    match:
      rule_family: error-info-leak
      file: "backend/**"
    reason: "_redact_exception_message() with _SENSITIVE_PATTERNS regex in _log_exception(). URL sanitization via _sanitize_url() allowlist."

  # JWT / Auth middleware — Properly configured
  - id: sup_017
    kind: already_fixed
    match:
      rule_family: weak-crypto
      file: "backend/middleware/auth.py"
    reason: "Auth middleware: always derives issuer, always verifies signature, null-checks sub claim, config warns if clerk_issuer not explicit."

  # Input validation — Implemented
  - id: sup_018
    kind: already_fixed
    match:
      rule_family: missing-input-validation
      file: "backend/api/routes/audit.py"
    reason: "_GITHUB_URL_RE regex validates GitHub URL format in audit.py before any downstream use."

  # GitHub OAuth endpoints — Auth is enforced by middleware
  - id: sup_019
    kind: already_fixed
    match:
      rule_family: missing-auth-check
      file: "backend/api/routes/github_oauth.py"
    reason: "All /api/github-oauth/* endpoints require auth (not in PUBLIC_PATHS). request.state.user_id used in all handlers."

  # URL sanitization — All logging paths redact query params
  - id: sup_020
    kind: already_fixed
    match:
      rule_family: sensitive-data-exposure
      file: "backend/middleware/**"
    reason: "Every logging path (AccessLogMiddleware, _log_exception, global error handler) calls _sanitize_url() with allowlist-based redaction. No raw URL is ever logged."

  # GitHub get_head_sha — Already wrapped in try/except
  - id: sup_021
    kind: already_fixed
    match:
      rule_family: unhandled-exception
      file: "backend/services/github_commit_ops.py"
    reason: "get_head_sha() in github_commit_ops.py wraps httpx calls in try/except for HTTPStatusError (404->branch_not_found, other->502) and RequestError (network error). Verified."

  # Scan wizard error handling — All async ops have try/catch
  - id: sup_022
    kind: already_fixed
    match:
      rule_family: missing-error-handling
      file: "frontend/contexts/scan-wizard-context.tsx"
    reason: "prefillFromProject and handleSubmit in scan-wizard-context.tsx both have try/catch with error state management. Verified."

  # ═══════════════════════════════════════════════════════════════════════
  # KNOWN LIMITATIONS — Tracked, not blocking
  # ═══════════════════════════════════════════════════════════════════════

  # Rate limiting — Per-process, Redis upgrade tracked
  - id: sup_023
    kind: accepted_risk
    match:
      rule_family: missing-rate-limit
    reason: "Per-process rate limiting is a known limitation. Redis upgrade tracked in backlog."
    expires: "2026-09-01"

  # Webhook cache — Bounded at 10K entries
  - id: sup_024
    kind: accepted_risk
    match:
      rule_family: resource-leak
      file: "backend/api/routes/webhook.py"
    reason: "Webhook delivery cache bounded at 10K entries with FIFO eviction."

  # Connection pooling — Configured with limits
  - id: sup_025
    kind: accepted_risk
    match:
      rule_family: missing-timeout
      file: "backend/services/http_client.py"
    reason: "shared_client in http_client.py configured with connection pooling (100 max, 20 keepalive, 30s timeout)."

  # ═══════════════════════════════════════════════════════════════════════
  # ARCHITECTURE — Capped at MEDIUM, tracked as tech debt
  # ═══════════════════════════════════════════════════════════════════════

  - id: sup_026
    kind: accepted_risk
    match:
      category: architecture
      max_severity: medium
    reason: "Architecture findings capped at MEDIUM per team policy."

  # ═══════════════════════════════════════════════════════════════════════
  # QUALITY — Low-severity observations, not actionable
  # ═══════════════════════════════════════════════════════════════════════

  # Magic numbers / duplicates
  - id: sup_027
    kind: accepted_risk
    match:
      category: quality
      max_severity: low
    reason: "Code quality observations. Duplicate utils and magic numbers are tracked as tech debt, not blockers."

  # Type annotations
  - id: sup_028
    kind: accepted_risk
    match:
      category: quality
      max_severity: low
    reason: "Type safety improvements tracked as tech debt."

  # Wildcard imports — intentional re-exports
  - id: sup_029
    kind: accepted_risk
    match:
      category: quality
      max_severity: low
    reason: "Wildcard imports in __init__.py files are intentional re-exports for backward compatibility (supabase_client.py split)."

  # ═══════════════════════════════════════════════════════════════════════
  # FRONTEND — Standard patterns, not vulnerabilities
  # ═══════════════════════════════════════════════════════════════════════

  # localStorage / NEXT_PUBLIC — Standard SPA patterns
  - id: sup_030
    kind: not_applicable
    match:
      rule_family: sensitive-data-exposure
      file: "frontend/**"
    reason: "Standard Next.js/SPA patterns. Only public URLs exposed, not secrets. Backend enforces real security boundaries."

  # Error boundary — Component exists
  - id: sup_031
    kind: not_applicable
    match:
      rule_family: missing-error-handling
      file: "frontend/**"
    reason: "ErrorBoundary component exists in components/error-boundary.tsx, wraps children in layout.tsx."

  # Client-side subscription/role checks — UX indicators only
  - id: sup_032
    kind: intentional
    match:
      rule_family: missing-auth-check
      file: "frontend/**"
    reason: "Client-side checks are UX indicators. Backend enforces real gates."

  # API client error handling — Middleware pipeline implemented
  - id: sup_033
    kind: not_applicable
    match:
      rule_family: missing-error-handling
      file: "frontend/**"
    reason: "errorMiddleware + retryMiddleware composed in apiFetch pipeline. Verified rounds 3-8."

  # Cache eviction — TTL and dedup implemented
  - id: sup_034
    kind: not_applicable
    match:
      rule_family: missing-cache
      file: "frontend/**"
    reason: "Frontend caching with 30s TTL and GET deduplication implemented. Non-GET dedup intentionally excluded."

  # ═══════════════════════════════════════════════════════════════════════
  # ALREADY FIXED — Standalone verified fixes
  # ═══════════════════════════════════════════════════════════════════════

  # Encryption key — Validated at startup
  - id: sup_035
    kind: already_fixed
    match:
      rule_family: weak-crypto
      file: "backend/config.py"
    reason: "_validate_encryption_key checks base64 + 32 bytes at startup. Rotation procedure documented in config.py docstring."

  # Pagination — Implemented on all list endpoints
  - id: sup_036
    kind: already_fixed
    match:
      rule_family: missing-pagination
    reason: "Pagination implemented on scans (20/page), projects (50/page), probes (20/page), project_scans (20/page). N+1 mitigated by get_projects_batch()."

  # Health check — Enforced at startup
  - id: sup_037
    kind: already_fixed
    match:
      rule_family: unhandled-exception
      file: "backend/main.py"
    reason: "Lifespan function calls check_database_health() and raises RuntimeError on failure. App won't start without DB."

  # ═══════════════════════════════════════════════════════════════════════
  # BROAD CATCH-ALL — Verified categories with rule_family targeting
  # ═══════════════════════════════════════════════════════════════════════

  # SSE / streaming logging — Authorization header never logged
  - id: sup_038
    kind: already_fixed
    match:
      rule_family: sensitive-data-exposure
      file: "backend/middleware/**"
    reason: "Logging only includes sanitized URLs via _sanitize_url(). Authorization header is never included in log output."

  # Server-side enforcement — confirmed in audit.py
  - id: sup_039
    kind: already_fixed
    match:
      rule_family: missing-auth-check
      file: "backend/api/routes/audit.py"
    reason: "audit.py checks user balance (lines 147-159) before creating scans. Server-side enforcement confirmed."

  # Environment validation — all critical secrets validated at startup
  - id: sup_040
    kind: already_fixed
    match:
      rule_family: missing-input-validation
      file: "backend/config.py"
    reason: "config.py has model_validators for: encryption key (base64 + 32 bytes), JWT secret (format), CORS (production warning), debug mode, clerk issuer, webhook secret."

  # PUBLIC_PREFIXES auth boundaries — intentional design
  - id: sup_041
    kind: intentional
    match:
      rule_family: missing-auth-check
      file: "backend/middleware/auth.py"
    reason: "PUBLIC_PREFIXES (/api/webhook/, /api/telemetry, /api/cli/) are intentionally unauthenticated — webhooks need to receive external callbacks, telemetry is fire-and-forget, CLI uses API keys."

  # ═══════════════════════════════════════════════════════════════════════
  # PERFORMANCE — Premature optimization, apply when profiling shows need
  # ═══════════════════════════════════════════════════════════════════════

  # React memoization
  - id: sup_042
    kind: accepted_risk
    match:
      category: performance
      max_severity: low
      file: "frontend/**"
    reason: "React memoization is a premature optimization. Apply when profiling shows re-render performance issues."

  # Lazy loading
  - id: sup_043
    kind: accepted_risk
    match:
      category: performance
      max_severity: low
      file: "frontend/**"
    reason: "Next.js handles route-level code splitting automatically. Component-level lazy loading applied when profiling shows need."

  # ═══════════════════════════════════════════════════════════════════════
  # OPENGREP FALSE POSITIVES — Pattern matching without data-flow analysis
  # ═══════════════════════════════════════════════════════════════════════

  # Logger user_id — Opengrep flags logger.exception("...%s", user_id) as
  # "hardcoded secret in logger." user_id is a Supabase UUID, not a secret.
  - id: sup_044
    kind: false_positive
    match:
      check_id: "python.lang.security.audit.logging.logger-credential-leak.python-logger-credential-disclosure"
    reason: "False positive: Opengrep flags parameterized logger calls with user_id (Supabase UUID) as 'hardcoded secret'. UUIDs are not secrets — they're standard debug context."

  # probe.py instruction strings — Opengrep misidentifies JSON instruction
  # strings as HTML injection and SQL injection.
  - id: sup_045
    kind: false_positive
    match:
      check_id: "python.django.security.injection.raw-html-format.raw-html-format"
      file: "backend/api/routes/probe.py"
    reason: "False positive: probe.py returns plain-text verification instructions as JSON values (DNS TXT, meta tag, file upload). Not rendered HTML or SQL queries."

  - id: sup_046
    kind: false_positive
    match:
      check_id: "python.django.security.injection.tainted-sql-string.tainted-sql-string"
      file: "backend/api/routes/probe.py"
    reason: "False positive: probe.py returns plain-text verification instructions as JSON values (DNS TXT, meta tag, file upload). Not rendered HTML or SQL queries."

  # Default credentials — critical secrets use Field(...) (required), optional
  # integrations (GitHub, Stripe, Clerk) use str | None = None intentionally
  # for environments where those integrations aren't configured.
  - id: sup_047
    kind: false_positive
    match:
      rule_family: sensitive-data-exposure
      file: "backend/config.py"
    reason: "False positive: critical secrets (openrouter_api_key, daytona_api_key, encryption_key) use Field(...) and are required. Optional integrations (github_client_id, stripe_secret_key) use None defaults intentionally — they're not deployed as defaults, they're absent until configured."

  # ═══════════════════════════════════════════════════════════════════════
  # DETERMINISTIC CHECK FALSE POSITIVES
  # ═══════════════════════════════════════════════════════════════════════

  # Cache-control headers are set globally via SecurityHeadersMiddleware in main.py.
  # LLM auditor missed it because it's middleware, not per-route.
  - id: sup_048
    kind: false_positive
    match:
      rule_family: missing-security-headers
      file: "backend/main.py"
    reason: "False positive: Cache-Control: no-store set globally via SecurityHeadersMiddleware (main.py:189). LLM auditor checks per-route, not middleware."

  # package-lock.json exists at frontend/package-lock.json.
  - id: sup_049
    kind: false_positive
    match:
      rule_family: missing-security-headers
      file: "frontend/**"
    reason: "False positive: package-lock.json exists in frontend/. Check failed to locate it."

  # Backend uses version ranges in requirements.txt, deployed via Docker.
  # No lock file by design — acceptable for current deployment model.
  - id: sup_050
    kind: accepted_risk
    match:
      rule_family: missing-security-headers
      file: "backend/**"
    expires: "2026-09-01"
    reason: "Accepted risk: backend uses version ranges in requirements.txt. Deployed via Docker with reproducible builds. Consider adding uv.lock when moving to uv."

  # ═══════════════════════════════════════════════════════════════════════
  # FALSE POSITIVES — Latest scan (2026-03-27)
  # ═══════════════════════════════════════════════════════════════════════

  # Role check on /api/fix — get_user_role() always returns a string
  - id: sup_051
    kind: false_positive
    match:
      rule_family: missing-auth-check
      file: "backend/api/routes/fix.py"
    reason: "False positive: get_user_role() always returns a string ('user' default), never None. Gate 'role != developer' correctly blocks non-developers."

  # SQL injection via Supabase — parameterized queries, no raw SQL
  - id: sup_052
    kind: false_positive
    match:
      rule_family: sql-injection
      file: "backend/**"
    reason: "False positive: Supabase Python client uses parameterized PostgREST queries, not string interpolation. No raw SQL construction."

  # Config validation — optional integration secrets use empty defaults
  - id: sup_053
    kind: accepted_risk
    match:
      rule_family: hardcoded-secret
      file: "backend/config.py"
    reason: "Accepted risk: optional integrations (Clerk, Stripe, GitHub OAuth) use empty defaults. Runtime 503 errors are acceptable — these services are optional per deployment."
    expires: "2026-09-01"
