# === Required ===

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# OpenRouter (LLM routing)
OPENROUTER_API_KEY=sk-or-...

# Daytona (sandbox execution)
DAYTONA_API_KEY=your-daytona-key
DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=eu  # Optional: leave unset for org default

# === Optional: GitHub Integration ===

# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_WEBHOOK_SECRET=change-me

# === Optional: FORGE Engine ===

# FORGE_ENABLED=false
# FORGE_AGENTFIELD_URL=http://localhost:8080
# FORGE_NODE_ID=forge-engine
# AGENTFIELD_API_KEY=your-agentfield-api-key
# FORGE_DEFAULT_MODEL=minimax/minimax-m2.5
# FORGE_RUNTIME=open_code
# FORGE_MAX_INNER_RETRIES=3
# FORGE_MAX_OUTER_REPLANS=1

# --- Clerk Auth (frontend integration) ---
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# === Optional: Tier 1 Overrides ===

# TIER1_ENABLED=true
# TIER1_ASSISTANT_MODEL=google/gemini-2.5-flash-lite
# TIER1_LOC_CAP=50000
