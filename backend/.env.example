# === Required ===

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# OpenRouter (LLM routing)
OPENROUTER_API_KEY=sk-or-...
# MODEL_SCANNER=google/gemini-2.0-flash-001  # Cheap model for primer summaries

# Daytona (sandbox execution)
DAYTONA_API_KEY=your-daytona-key
DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=eu  # Optional: leave unset for org default

# === Optional: CORS ===
# CORS_ALLOWED_ORIGINS=https://www.vibe2prod.com,https://app-staging.vibe2prod.verstandai.site
# CORS_VERCEL_PROJECTS=my-app,frontend-app  # Restrict Vercel preview URLs to specific project names

# === Optional: GitHub Integration ===

# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_WEBHOOK_SECRET=change-me
# GITHUB_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://www.vibe2prod.com,http://localhost:3000

# === Optional: FORGE Sandbox ===
# FORGE_SANDBOX_CPU=2
# FORGE_SANDBOX_MEMORY_GB=4
# FORGE_SANDBOX_DISK_GB=10
# FORGE_SANDBOX_TIMEOUT_MINUTES=20
# FORGE_SANDBOX_EXEC_TIMEOUT=600
# FORGE_PACKAGE_SOURCE=vibe2prod  # Override with git+https://... for private repos

# === Optional: FORGE Engine ===

# FORGE_ENABLED=false
# FORGE_AGENTFIELD_URL=http://localhost:8080
# FORGE_NODE_ID=forge-engine
# AGENTFIELD_API_KEY=your-agentfield-api-key
# FORGE_DEFAULT_MODEL=minimax/minimax-m2.5
# FORGE_RUNTIME=open_code
# FORGE_MAX_INNER_RETRIES=3
# FORGE_MAX_OUTER_REPLANS=1
# FORGE_POLL_INTERVAL_SECONDS=10
# FORGE_REMEDIATE_TIMEOUT_SECONDS=2700
# FORGE_WEBHOOK_BASE_URL=https://api.vibe2prod.com

# --- Clerk Auth (frontend integration) ---
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# === Optional: Stripe ===
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# === Optional: User Defaults ===
# DEFAULT_USER_ROLE=user

# === Optional: Frontend ===
# FRONTEND_URL=http://localhost:3000

# === Optional: Environment ===
# ENVIRONMENT=production  # Set to "development" to enable dev-only features

# === Optional: Live Probe ===
# PROBE_ENABLED=false
# PROBE_MAX_CONCURRENT=5
# PROBE_REQUEST_TIMEOUT_SECONDS=10
# PROBE_MAX_URLS_PER_PROBE=100
# PROBE_RATE_LIMIT_PER_TARGET=10

# === Optional: Security Probe Service (external microservice) ===
# PROBE_SERVICE_URL=
# PROBE_SERVICE_API_KEY=

# === Optional: Project Limits ===
# PROJECT_CAP=3
