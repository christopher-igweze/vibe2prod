  "data_flows": [
    {
      "source": "Frontend UnifiedInputPane",
      "destination": "Backend /generate_code endpoint",
      "data_type": "image upload / text prompt / URL",
      "is_authenticated": false
    },
    {
      "source": "Backend /generate_code endpoint",
      "destination": "LLM Provider (OpenAI/Anthropic/Gemini)",
      "data_type": "Constructed prompts with image context",
      "is_authenticated": true
    },
    {
      "source": "LLM Provider Response",
      "destination": "Agent Engine",
      "data_type": "LLM response with tool calls",
      "is_authenticated": true
    },
    {
      "source": "Agent Engine",
      "destination": "Tool Runtime (Write/Read/Bash/Terminal)",
      "data_type": "Tool execution requests",
      "is_authenticated": true
    },
    {
      "source": "Agent Tools",
      "destination": "File System",
      "data_type": "Code files, project structure",
      "is_authenticated": true
    },
    {
      "source": "Backend WebSocket",
      "destination": "Frontend Preview Pane",
      "data_type": "Streaming code updates, status messages",
      "is_authenticated": false
    },
    {
      "source": "Frontend",
      "destination": "Replicate API",
      "data_type": "Image generation requests",
      "is_authenticated": true
    }
  ],
