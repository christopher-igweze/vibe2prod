  "data_flows": [
    {
      "source": "AuthPage (Login/Signup)",
      "destination": "Database via Wasp Auth",
      "data_type": "user credentials (email/password)",
      "is_authenticated": false
    },
    {
      "source": "PricingPage",
      "destination": "Payment Provider (Stripe/LemonSqueezy/Polar)",
      "data_type": "payment intent, checkout session",
      "is_authenticated": true
    },
    {
      "source": "Payment Webhook",
      "destination": "Database",
      "data_type": "subscription status, payment confirmation",
      "is_authenticated": false
    },
    {
      "source": "FileUploadPage",
      "destination": "AWS S3 + Database",
      "data_type": "file binary, metadata",
      "is_authenticated": true
    },
    {
      "source": "Landing Page / Client App",
      "destination": "Analytics Providers (Google/Plausible)",
      "data_type": "page views, events",
      "is_authenticated": false
    },
    {
      "source": "User AccountPage",
      "destination": "Database via User operations",
      "data_type": "user profile data",
      "is_authenticated": true
    },
    {
      "source": "Admin Dashboard",
      "destination": "Database via Analytics operations",
      "data_type": "aggregated analytics, user data",
      "is_authenticated": true
    }
  ],
